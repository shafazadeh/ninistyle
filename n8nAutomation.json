		{
			"parameters": {
				"jsCode": "// دریافت آبجکت ارسال‌شده از سمت فرانت‌اند (با ساپورت حالت‌های body دار و مستقیم)\nconst item = $input.first()?.json || {};\nconst body = item.body || item;\n\n// فرانت‌اند ممکن است مقادیر را با data:image/.../base64, فرستاده باشد یا بیس۶۴ خالص\nconst cleanBase64 = (val) => {\n  if (!val || typeof val !== 'string') return '';\n  return val.includes(',') ? val.split(',')[1] : val;\n};\n\n// گرفتن عکس‌ها از کلیدهای احتمالی فرانت\nconst rawProduct = body.clothingImage || body.productImage || body.clothB64 || '';\nconst rawCharacter = body.childImage || body.characterImage || body.childB64 || '';\n\nconst productBase64 = cleanBase64(rawProduct);\nconst characterBase64 = cleanBase64(rawCharacter);\n\n// ساخت Data URL استاندارد برای نود Nano / avalai\nconst productImageUrl = productBase64 ? `data:image/jpeg;base64,${productBase64}` : '';\nconst characterImageUrl = characterBase64 ? `data:image/jpeg;base64,${characterBase64}` : '';\n\nreturn {\n  productImageUrl,\n  characterImageUrl,\n  clothingTitle: body.clothingTitle || '',\n  clothingId: body.clothingId || ''\n};\n"
			},
